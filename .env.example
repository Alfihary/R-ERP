# Variables mínimas de CONFIG-0. Copiar a .env solo para configuración local.

APP_NAME=SoporteGR ERP
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_SESSION_NAME=soportegr_session
APP_SESSION_SECURE_COOKIE=false
APP_SESSION_SAME_SITE=Lax
APP_SESSION_GC_MAX_LIFETIME=7200
APP_CSRF_TTL_SECONDS=7200

APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_NAME=
APP_DB_USER=
APP_DB_PASSWORD=
APP_DB_CHARSET=utf8mb4
APP_DB_COLLATION=utf8mb4_unicode_ci

APP_INITIAL_ADMIN_USERNAME=jesus.g
APP_INITIAL_ADMIN_EMAIL=
APP_INITIAL_ADMIN_PASSWORD=

# Destinatario único para tooling QA de correo. Mantener vacío en plantilla.
MAIL_TEST_RECIPIENT=
